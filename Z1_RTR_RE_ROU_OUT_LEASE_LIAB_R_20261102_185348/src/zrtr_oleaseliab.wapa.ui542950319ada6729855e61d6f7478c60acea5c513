                                                                                                                                                                                                                                                               
sap.ui.define([],                                                                                                                                                                                                                                              
    function () {                                                                                                                                                                                                                                              
        "use strict";                                                                                                                                                                                                                                          
        return {                                                                                                                                                                                                                                               
            getMessagefromHTTPRespond: function (oRespond) {                                                                                                                                                                                                   
                let vMessage;                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                if (!oRespond) {                                                                                                                                                                                                                               
                    return vMessage;                                                                                                                                                                                                                           
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                if (!vMessage &&                                                                                                                                                                                                                               
                    oRespond.responseText) {                                                                                                                                                                                                                   
                    try {                                                                                                                                                                                                                                      
                        // Try JSON                                                                                                                                                                                                                            
                        let oResponseText = JSON.parse(oRespond.responseText);                                                                                                                                                                                 
                        vMessage = oResponseText?.error?.message?.value;                                                                                                                                                                                       
                    } catch (error) {                                                                                                                                                                                                                          
                        try {                                                                                                                                                                                                                                  
                            // Try XML                                                                                                                                                                                                                         
                            let oDOMParser = new DOMParser();                                                                                                                                                                                                  
                            let oXMLDoc = oDOMParser.parseFromString(oRespond.responseText, "text/xml");                                                                                                                                                       
                            vMessage = oXMLDoc.getElementsByTagName("message")[0]?.childNodes[0]?.nodeValue                                                                                                                                                    
                        } catch (error) {                                                                                                                                                                                                                      
                            // Do nothing                                                                                                                                                                                                                      
                        }                                                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                if (!vMessage &&                                                                                                                                                                                                                               
                    oRespond.statusText) {                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                    vMessage = oRespond.statusText;                                                                                                                                                                                                            
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                if (!vMessage &&                                                                                                                                                                                                                               
                    oRespond.message) {                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    vMessage = oRespond.message;                                                                                                                                                                                                               
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                return vMessage;                                                                                                                                                                                                                               
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            convertContentToURL: function (sContent, sMIMEType) {                                                                                                                                                                                              
                var sContent2 = window.atob(sContent);                                                                                                                                                                                                         
                var aLength = new Array(sContent2.length);                                                                                                                                                                                                     
                for (var i = 0; i < sContent2.length; i++) {                                                                                                                                                                                                   
                    aLength[i] = sContent2.charCodeAt(i);                                                                                                                                                                                                      
                }                                                                                                                                                                                                                                              
                var aByteArray = new Uint8Array(aLength);                                                                                                                                                                                                      
                var oBlob = new Blob([aByteArray], {                                                                                                                                                                                                           
                    type: sMIMEType                                                                                                                                                                                                                            
                });                                                                                                                                                                                                                                            
                var sURL = window.URL.createObjectURL(oBlob);                                                                                                                                                                                                  
                return sURL;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        };                                                                                                                                                                                                                                                     
    });                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               