sap.ui.define([                                                                                                                                                                                                                                                
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "../util/Util"                                                                                                                                                                                                                                             
], function (MessageToast, MessageBox, Util) {                                                                                                                                                                                                                 
    'use strict';                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
        ExportExcel: function (oEvent) {                                                                                                                                                                                                                       
            const oFilterBar = this.byId("zpttgc.rtr.outstandingleaseliabilityreport::sap.suite.ui.generic.template.ListReport.view.ListReport::OutLeaseLiabRepResults--listReportFilter");                                                                    
            const oView = this.getView();                                                                                                                                                                                                                      
            const oModel = oView.getModel();                                                                                                                                                                                                                   
            const oFilterData = oFilterBar.getFilterData();                                                                                                                                                                                                    
            const aFilters = oFilterBar.getFilters();                                                                                                                                                                                                          
            const oUrlParameters = {                                                                                                                                                                                                                           
                "_Document": []                                                                                                                                                                                                                                
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            const oDateFormat = sap.ui.core.format.DateFormat.getDateInstance({                                                                                                                                                                                
                pattern: "yyyy-MM-dd"                                                                                                                                                                                                                          
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
                const sCompanyCode = oFilterData["$Parameter.P_CompanyCode"];                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                if (sCompanyCode) {                                                                                                                                                                                                                            
                    oUrlParameters.CompanyCode = sCompanyCode;                                                                                                                                                                                                 
                }                                                                                                                                                                                                                                              
            } catch (error) {                                                                                                                                                                                                                                  
                //Do nothing                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
                const oKeyDate = oFilterData["$Parameter.P_KeyDate"].ranges[0].value1;                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                if (oKeyDate) {                                                                                                                                                                                                                                
                    oUrlParameters.KeyDate = oDateFormat.format(oKeyDate);                                                                                                                                                                                     
                }                                                                                                                                                                                                                                              
            } catch (error) {                                                                                                                                                                                                                                  
                //Do nothing                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oView.setBusy(true);                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            oModel.callFunction("/GetExcel", {                                                                                                                                                                                                                 
                success: function (oDataContext, oResponse) {                                                                                                                                                                                                  
                    oView.setBusy(false);                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                    const oLink = document.createElement("a");                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    oLink.href = Util.convertContentToURL(oDataContext.GetExcel.FileContent, oDataContext.GetExcel.MimeType);;                                                                                                                                 
                    oLink.download = oDataContext.GetExcel.FileName;                                                                                                                                                                                           
                    oLink.click();                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                    window.URL.revokeObjectURL(oDataContext.href);                                                                                                                                                                                             
                },                                                                                                                                                                                                                                             
                error: function (oError) {                                                                                                                                                                                                                     
                    oView.setBusy(false);                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                    MessageBox.error(Util.getMessagefromHTTPRespond(oError));                                                                                                                                                                                  
                },                                                                                                                                                                                                                                             
                method: "POST",                                                                                                                                                                                                                                
                urlParameters: oUrlParameters                                                                                                                                                                                                                  
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
        }                                                                                                                                                                                                                                                      
    }                                                                                                                                                                                                                                                          
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               